# Shared source of truth for e2e fixture configuration.
#
# This file is consumed by test/e2e/isos.mk (via `include` + `export`) so
# that Make and the Go test suite in test/e2e/helpers/fixtures.go see the
# exact same values. The Makefile expands these into ISO build targets;
# `make test-e2e` then invokes `go test`, which reads the exported vars
# through os.Getenv.
#
# Syntax constraint: use POSIX-style `KEY=value` with no spaces around `=`
# and no shell quoting so Make's `include` accepts the file directly.
# Values are treated as whitespace-separated lists where relevant.

# Registry hostname baked into every image reference inside the fixture
# ISOs. It must (a) contain a dot so containerd treats it as a registry
# and (b) match the pull refs used by the Go tests.
E2E_IMAGE_HOST=e2e.metalk8s.scality.com

# Two-digit indices for the bulk-small and bulk-big fixtures. The
# Makefile expands `bulk-<kind>-<index>.iso` targets from these; the Go
# tests iterate over the same lists to upload/pull them.
BULK_SMALL_INDICES=01 02 03 04 05 06 07 08 09 10
BULK_BIG_INDICES=01 02
